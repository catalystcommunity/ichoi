// IOS-00: the permanent App Store bundle ID. It cannot change after publication.
#include "Base.xcconfig"
// verify-release.sh rejects an unresolved or development ID.
ICHOI_PERMANENT_BUNDLE_ID = com.catalystsquad.ichoi
PRODUCT_BUNDLE_IDENTIFIER = $(ICHOI_PERMANENT_BUNDLE_ID)
SWIFT_ACTIVE_COMPILATION_CONDITIONS = RELEASE
