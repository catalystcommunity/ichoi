;; Ichoi — jukebox control: players, queues, transport, shared-target subscription (§6).

PlayerKind = "shared" / "private"

Player = {
    id: PlayerId,
    kind: PlayerKind,
    name: text,                      ;; "Kitchen · Main Speakers" or "Ann's Device"
    ? node_id: NodeId,
    ? device_id: DeviceId,
    ? owner: AccountId,
    ;; True while the output is reachable but silent until a person acts at it. Browser
    ;; satellites report this when the autoplay policy blocks them. Controllers show it so
    ;; a listener knows the target will not make sound yet.
    ? audio_blocked: bool .default false
}

QueueItem = {
    queue_item_id: uint,
    track_id: TrackId,
    ? library: Library,
    ? title: text,
    ? artist: text,
    ? duration_ms: uint
}

PlayerState = {
    player_id: PlayerId,
    revision: uint,
    status: PlayerStatus,
    ? current_index: uint,
    ? playback_id: text,
    ? position_ms: uint,
    volume: uint .le 100 .default 100,
    repeat_mode: RepeatMode,
    shuffle: bool .default false,
    ? error: text,
    can_undo: bool .default false,
    queue: [* QueueItem]
}

ListPlayersRequest  = { ? kind: PlayerKind }
ListPlayersResponse = { players: [* Player] }

SubscribeRequest = { player_id: PlayerId, ? active: bool .default true }

;; Transport/queue commands (client -> server), discriminated on `op`.
CmdEnqueue  = { op: "enqueue", track_ids: [+ TrackId], ? at_index: uint }
CmdEnqueueNext = { op: "enqueue-next", track_ids: [+ TrackId] }
CmdRemove   = { op: "remove", index: uint }
CmdRemoveItem = { op: "remove-item", queue_item_id: uint }
CmdReorder  = { op: "reorder", from_index: uint, to_index: uint }
CmdMoveItem = { op: "move-item", queue_item_id: uint, ? before_queue_item_id: uint }
CmdClear    = { op: "clear" }
CmdPlay     = { op: "play", ? index: uint, ? queue_item_id: uint }
CmdReplaceAndPlay = { op: "replace-and-play", track_ids: [+ TrackId], ? start_index: uint .default 0, ? position_ms: uint .default 0 }
CmdPause    = { op: "pause" }
CmdNext     = { op: "next" }
CmdPrevious = { op: "previous" }
CmdSeek     = { op: "seek", position_ms: uint }
CmdVolume   = { op: "volume", volume: uint .le 100 }
CmdSetRepeat = { op: "set-repeat", repeat_mode: RepeatMode }
CmdSetShuffle = { op: "set-shuffle", shuffle: bool }
CmdUndo = { op: "undo" }
;; Browser outputs use this command only to report a physical terminal event. Native
;; satellites send the equivalent NodeReport.
CmdPlaybackCompleted = { op: "playback-completed", playback_id: text, queue_item_id: uint }
CmdPlaybackFailed = { op: "playback-failed", playback_id: text, queue_item_id: uint, error: text .size (1..1024) }
CmdPlaybackState = { op: "playback-state", playback_id: text, queue_item_id: uint, status: PlayerStatus, position_ms: uint }
PlayerCommand = CmdEnqueue / CmdEnqueueNext / CmdRemove / CmdRemoveItem / CmdReorder / CmdMoveItem / CmdClear / CmdPlay / CmdReplaceAndPlay / CmdPause / CmdNext / CmdPrevious / CmdSeek / CmdVolume / CmdSetRepeat / CmdSetShuffle / CmdUndo / CmdPlaybackCompleted / CmdPlaybackFailed / CmdPlaybackState

CommandRequest = { player_id: PlayerId, command: PlayerCommand }

;; Client satellite mode (§6.4): target named "<Handle>'s <suffix>", suffix unique per server.
EnableShareRequest  = { ? suffix: text .size (1..48) .default "Device" }
DisableShareRequest = { player_id: PlayerId }
ShareResult         = { player: Player }

service PlayerService {
    list-players: ListPlayersRequest -> ListPlayersResponse / ServiceError,
    get-state: SubscribeRequest -> PlayerState / ServiceError,
    subscribe: SubscribeRequest <-> PlayerState,
    control: CommandRequest -> PlayerState / ServiceError,
    enable-share: EnableShareRequest -> ShareResult / ServiceError,
    disable-share: DisableShareRequest -> Ok / ServiceError
}
