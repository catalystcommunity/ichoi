# Rust
/target
**/target
*.rs.bk

# Node / web UI build (SolidJS themes under web/)
node_modules
**/node_modules
dist
**/dist
web/**/dist
*.tsbuildinfo

# SQLite databases (WAL) and local media — never commit
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Environment / secrets
.env
.env.*
*.jks
*.keystore
*.p12
*.p8
*.mobileprovision

# Local tooling / editor / scratch state
/scratch/
.claude/
.codex/
.agents/
.playwright-mcp/

# Python bytecode. Importing a Reactorcide plugin for a local test writes it into
# .reactorcide/plugins/.
__pycache__/
*.pyc

# OS cruft
.DS_Store
Thumbs.db

# `reactorcide run-local` writes a run summary at the repository root.
/reactorcide-workflow-summary.json
.workflow-summary-*.tmp

# iOS: archives and exports, SwiftPM state, and per-user Xcode state.
/ios/build/
/ios/.build/
/ios/.swiftpm/
xcuserdata/
DerivedData/

# assets/brand/build.py writes a share archive. Do not commit it.
/assets/brand/ichoi-brand-kit.zip
